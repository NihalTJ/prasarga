# ─── Video Generation (2026 Best Models) ──────────────────────
# Kling 3.0 — best realistic human motion, 4K, native audio
# Get key: https://klingai.com
KLING_API_KEY=

# Google Veo 3.1 — best cinematic quality with synced audio
# Get key: https://aistudio.google.com/apikey
VEO_API_KEY=

# MiniMax Hailuo 02 — fastest & cheapest, best for social media
# Get key: https://hailuoai.video
MINIMAX_API_KEY=

# Runway Gen-4.5 — best for brand/marketing content
# Get key: https://runwayml.com/api/
RUNWAY_API_KEY=

# Pika 2.0 — creative effects, trending content
# Get key: https://pika.art
PIKA_API_KEY=

# Replicate — fallback, hosts multiple models
# Get key: https://replicate.com/account/api-tokens
REPLICATE_API_KEY=

# Default provider (recommended: minimax for social media creators)
# Options: kling, veo, minimax, runway, pika, replicate
DEFAULT_VIDEO_PROVIDER=minimax

# ─── YouTube / YouTube Shorts ────────────────────────────────
# PRIMARY monetization platform for AI creators (45% revenue share)
# Get credentials: Google Cloud Console → YouTube Data API v3
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_ACCESS_TOKEN=
YOUTUBE_REFRESH_TOKEN=

# ─── Instagram Reels ──────────────────────────────────────────
# No direct payment — use for brand deals & audience growth
# Get token: Facebook Developer → Instagram Graph API
INSTAGRAM_ACCESS_TOKEN=

# ─── Facebook Reels ──────────────────────────────────────────
# Available in India. In-stream ads monetization (55% revenue share).
# Get credentials: https://developers.facebook.com/docs/facebook-login
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=

# ─── X (Twitter) ──────────────────────────────────────────────
# Great for AI content virality & engagement
# Get credentials: https://developer.x.com/
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# ─── App Settings ─────────────────────────────────────────────
SECRET_KEY=change-this-in-production
DEBUG=true
PORT=5000

# ─── Social Media OS Integration ───────────────────────────────
# Connect to your Social Media OS platform for automated scheduling
# and cross-platform posting. The Social Media OS exposes a POST
# /api/content/ingest endpoint that receives video content.
#
# 1. Deploy your Social Media OS (Railway/Render)
# 2. Set SOCIAL_OS_URL to its base URL
# 3. Set SOCIAL_OS_API_KEY to the shared secret you configure on both sides
# 4. Set SOCIAL_OS_ENABLED=true to activate
SOCIAL_OS_ENABLED=false
SOCIAL_OS_URL=
SOCIAL_OS_API_KEY=
SOCIAL_OS_INGEST_ENDPOINT=/api/content/ingest
